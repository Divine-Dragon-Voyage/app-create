{
  "name": "app-create",
  "version": "1.0.0",
  "description": "使用 Playwright 自动在 Google Play Console 创建应用并完成常见声明流程。",
  "main": "create_app.js",
  "scripts": {
    "start": "node create_app.js",
    "bootstrap:win": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\bootstrap_windows.ps1",
    "bootstrap:win:auto": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\bootstrap_windows.ps1 -AutoLaunchBrowser",
    "deploy:win": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\deploy_windows.ps1 -Mode installOrUpdate -AutoLaunchBrowser",
    "update:win": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\deploy_windows.ps1 -Mode update -AutoLaunchBrowser",
    "release:zip": "bash ./package_release.sh",
    "release:zip:win": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\package_release.ps1",
    "release:exe:win": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tech_ops\\build_installer.ps1",
    "release:launcher:exe:win": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tech_ops\\build_launcher_installer.ps1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taiwuyang1/app-create.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/taiwuyang1/app-create/issues"
  },
  "homepage": "https://github.com/taiwuyang1/app-create#readme",
  "private": true,
  "dependencies": {
    "playwright": "^1.59.1",
    "xlsx": "^0.18.5"
  }
}
